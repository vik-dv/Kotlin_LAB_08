<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.sharedpreferencesapp.FirstFragment"
        android:label="FirstFragment"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_firstFragment_to_fragment2"
            app:destination="@id/fragment2" />

    </fragment>

    <fragment
        android:id="@+id/fragment2"
        android:name="com.example.sharedpreferencesapp.Fragment2"
        android:label="Fragment2"
        tools:layout="@layout/fragment_2">

        <action
            android:id="@+id/action_fragment2_to_fragment3"
            app:destination="@id/fragment3" />

    </fragment>

    <fragment
        android:id="@+id/fragment3"
        android:name="com.example.sharedpreferencesapp.Fragment3"
        android:label="Fragment3"
        tools:layout="@layout/fragment_3" />

</navigation>